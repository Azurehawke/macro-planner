POSTGRES_USER=macro_planner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=macro_planner
JWT_SECRET=change-me-to-a-long-random-string
APP_PORT=9125

# Set to false ONLY if you're testing over plain http:// (e.g. hitting the
# server's IP directly before Cloudflare/DNS is wired up). Browsers silently
# drop Secure cookies over http://, which breaks login. Once you're accessing
# the site over https:// (e.g. through Cloudflare), leave this as true.
COOKIE_SECURE=true

# Optional: enables searching USDA FoodData Central from the Foods page.
# Free key, no cost: https://fdc.nal.usda.gov/api-key-signup.html
# Leave blank to skip USDA results (Open Food Facts search still works).
USDA_FDC_API_KEY=

# Optional: identifies your instance to Open Food Facts per their API usage
# policy. Leave blank to use a generic default.
OFF_USER_AGENT=
